# One-time administrator bootstrap environment. Copy to /etc/oculis/bootstrap.env with
# root:root mode 0600 only while creating the first administrator. Delete it and
# restart oculis-web immediately after the first verified administrative login.

OCULIS_BOOTSTRAP_ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
OCULIS_BOOTSTRAP_ADMIN_NAME="Equipo FHC"
OCULIS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_STRONG_UNIQUE_ADMIN_PASSWORD
