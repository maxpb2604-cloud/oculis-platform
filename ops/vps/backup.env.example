# PostgreSQL backup environment. Copy to /etc/oculis/backup.env and keep root:root mode
# 0600. This file is read only by systemd for oculis-backup.service.

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=oculis
PGUSER=oculis
PGPASSWORD=REPLACE_URL_SAFE_DB_PASSWORD
PGCONNECT_TIMEOUT=10

OCULIS_BACKUP_DIR=/var/backups/oculis/postgresql
OCULIS_BACKUP_RETENTION_DAYS=14

# Optional encrypted off-server backup through restic. Leave both empty to disable.
# systemd reads this root-only env before starting the unprivileged backup process.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
