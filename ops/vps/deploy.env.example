# Non-secret configuration for /usr/local/sbin/oculis-deploy.
# Copy to /etc/oculis/deploy.env with root:root mode 0644.
OCULIS_REPOSITORY=https://github.com/maxpb2604-cloud/oculis-platform.git
OCULIS_DEPLOY_ROOT=/opt/oculis
OCULIS_ENV_FILE=/etc/oculis/web.env
OCULIS_BUILD_USER=oculis-build
OCULIS_KEEP_RELEASES=5
OCULIS_WEB_SERVICE=oculis-web.service
OCULIS_PUBLIC_PROXY_SERVICE=caddy.service
OCULIS_INGEST_LOCK_WAIT_SECONDS=21600

# Normal automated releases always use production + schema verification. Special
# modes are one-shot wrapper subcommands and are intentionally not persistent here.
OCULIS_DEPLOY_TESTS=0
