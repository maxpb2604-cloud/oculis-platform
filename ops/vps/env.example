# Web/deploy environment. Copy to /etc/oculis/web.env, replace every REPLACE_* value,
# and keep root:root mode 0600. Keep every value on one line; quote values containing
# spaces. Do not commit the real file. Worker, backup, and one-time administrator
# bootstrap credentials belong in their separate templates.

NODE_ENV=production
OCULIS_ENV=production
OCULIS_AUTO_MIGRATE=0
OCULIS_DB_APP_NAME=oculis-vps
PG_POOL_MAX=5

# Canonical external HTTPS origin. No path, query string, fragment, or trailing slash.
# This must match the domain in /etc/oculis/caddy.env.
OCULIS_PUBLIC_URL=https://oculis.example.com

# Readiness fails below this accepted data floor. Set it from the verified migration
# baseline before enabling public traffic; it must never be zero.
OCULIS_MIN_READY_INITIATIVES=REPLACE_VERIFIED_INITIATIVE_COUNT_FLOOR

# Use a URL-safe database password so DATABASE_URL does not need ambiguous escaping.
DATABASE_URL=postgresql://oculis:REPLACE_URL_SAFE_DB_PASSWORD@127.0.0.1:5432/oculis

# Must be stable, private, and at least 32 characters. Changing it invalidates sessions.
OCULIS_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Public browser token; it is embedded at build time by Next.js.
NEXT_PUBLIC_MAPBOX_TOKEN=REPLACE_MAPBOX_PUBLIC_TOKEN
