# Worker/health environment. Copy to /etc/oculis/worker.env and keep root:root mode
# 0600. It intentionally contains no session, administrator-bootstrap, pg_dump, or
# off-server backup credentials.

NODE_ENV=production
OCULIS_ENV=production
OCULIS_AUTO_MIGRATE=0
OCULIS_DB_APP_NAME=oculis-vps-worker
PG_POOL_MAX=5

DATABASE_URL=postgresql://oculis:REPLACE_URL_SAFE_DB_PASSWORD@127.0.0.1:5432/oculis
OCULIS_DOCS_DIR=/var/lib/oculis/documents
OCULIS_INGEST_LOCK_WAIT_SECONDS=21600

# Keep this identical to the verified migration floor in /etc/oculis/web.env.
OCULIS_MIN_READY_INITIATIVES=REPLACE_VERIFIED_INITIATIVE_COUNT_FLOOR

# Optional integrations used only when their corresponding ingestion is enabled.
GRAPH_CLIENT_ID=
X_BEARER_TOKEN=
