{
  "name": "oculis-auribus",
  "private": true,
  "version": "0.0.0",
  "description": "Automated legislative & regulatory monitoring platform for the Dominican Republic",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "daily": "npm run daily -w @oculis/worker",
    "dev": "npm run dev -w @oculis/web"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.61.0",
    "tsx": "^4.22.4"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "unpdf": "^1.6.2"
  }
}
