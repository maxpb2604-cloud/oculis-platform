{
  "name": "oculis-auribus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Automated legislative & regulatory monitoring platform for the Dominican Republic",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "daily": "npm run daily -w @oculis/worker",
    "dev": "npm run dev -w @oculis/web",
    "check:factual": "node scripts/check-factual-policy.mjs",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "playwright": "^1.61.0",
    "prettier": "^3.3.0",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.10.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "unpdf": "^1.6.2"
  }
}
