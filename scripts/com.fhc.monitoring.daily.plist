<?xml version="1.0" encoding="UTF-8"?>
<!--
  FHC daily monitoring launchd job.

  Install (one time):
    cp scripts/com.fhc.monitoring.daily.plist ~/Library/LaunchAgents/
    # edit the ProgramArguments path below to your absolute repo path if it differs
    launchctl load ~/Library/LaunchAgents/com.fhc.monitoring.daily.plist

  It runs scripts/daily.sh every day at 07:30 (and once at load). Logs land in
  app/.data/logs/. To stop: launchctl unload ~/Library/LaunchAgents/com.fhc.monitoring.daily.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fhc.monitoring.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/emilpenabautista/Desktop/Oculis Auribus/app/scripts/daily.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/emilpenabautista/Desktop/Oculis Auribus/app/.data/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/emilpenabautista/Desktop/Oculis Auribus/app/.data/logs/launchd.err.log</string>
</dict>
</plist>
