# Cloud/Postgres connection used by both the web app and the worker.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Keep the free Neon plan healthy by limiting connections per process.
PG_POOL_MAX=5
OCULIS_DB_APP_NAME=oculis-local

# Canonical external origin served by Caddy or another trusted reverse proxy.
# Used for same-origin validation and redirects in administrative APIs.
# OCULIS_PUBLIC_URL=https://oculis.example.com
# Positive production data floor checked by /api/ready.
# OCULIS_MIN_READY_INITIATIVES=9000

# Local embedded database alternative. Prefer an absolute path so every workspace
# resolves the same store. Never enable this silently in a cloud deployment.
# DB_DRIVER=pglite
# PGLITE_DIR=/absolute/path/to/oculis/.data/pglite

# Only needed if the web process itself should apply bootstrap DDL in production.
# Prefer running schema setup in a deploy/worker step instead.
# OCULIS_AUTO_MIGRATE=0

# Administrative portal. Keep these values in secret storage, never in Git.
# OCULIS_SESSION_SECRET=generate-at-least-32-random-characters
# OCULIS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# OCULIS_BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-with-12-or-more-characters
# OCULIS_BOOTSTRAP_ADMIN_NAME=Equipo FHC

# Optional integrations.
# NEXT_PUBLIC_MAPBOX_TOKEN=
# X_BEARER_TOKEN=
