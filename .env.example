# Copy to .env and fill in. All optional for local dev.

# Postgres / AWS RDS connection. If unset, the worker uses in-memory PGlite.
# DATABASE_URL=postgres://user:pass@localhost:5432/oculis

# Persist PGlite to disk instead of memory (ignored when DATABASE_URL is set).
# PGLITE_DIR=./.data/pglite

# Anthropic API key — required for Phase 3 (auto-categorization & scoring estimates).
# ANTHROPIC_API_KEY=sk-ant-...

# Claude is STRICTLY OPT-IN to avoid surprise billing. The worker uses the free
# heuristic categorizer unless you set BOTH a key above AND this flag to 1.
# OCULIS_USE_CLAUDE=1
# OCULIS_CLASSIFIER_MODEL=claude-haiku-4-5   # cheapest; or claude-opus-4-8

# X / Twitter live posts (the "Redes" feed). This is an APP BEARER TOKEN from the
# X Developer Portal (developer.x.com) — NOT an account username/password. Requires
# a paid X API plan (Basic ~$200/mo) for the v2 user-timeline endpoints we call.
# Without it, the social feed stays a link-only directory.
# X_BEARER_TOKEN=AAAA...
